---
import type { CollectionEntry } from "astro:content";
import { formatEventDate } from "../utils";

interface Props {
  event: CollectionEntry<"events">;
  refdes: string;
  past?: boolean;
}

const { event, refdes, past = false } = Astro.props;
const {
  title,
  date,
  endDate,
  time,
  location,
  type,
  summary,
  recurrence,
  registrationUrl,
  websiteUrl,
  coverUrl,
  coverAlt,
  sourceUrl,
  recap,
} = event.data;

const typeStyles: Record<string, string> = {
  workshop: "border-silk-faint text-silk-dim",
  hackathon: "border-gold text-gold",
  social: "border-signal-bright text-signal-bright",
  other: "border-silk-faint text-silk-dim",
};

/**
 * Covers live on the Engage CDN, which resizes via `preset`. Serving them
 * straight from there keeps dozens of remote images out of the build.
 * Valid presets: small-sq, med-sq, med-w (600x360), large-w (1000x600). The
 * wide pair is 5:3, which is why the card frames covers at that ratio rather
 * than cropping them to 16:9.
 */
const cover = (preset: string) => `${coverUrl}?preset=${preset}`;
---

{/* The Eagle Engage link below stretches over the whole card, so clicking
    anywhere opens the event. Keyboard focus lands on that link, hence the
    focus ring on the card itself. */}
<article
  class="card-ic flex flex-col focus-within:border-gold focus-within:outline focus-within:outline-gold"
>
  <img
    src={cover("med-w")}
    srcset={`${cover("med-w")} 600w, ${cover("large-w")} 1000w`}
    sizes="(min-width: 640px) 290px, 100vw"
    alt={coverAlt}
    width="1000"
    height="600"
    loading={past ? "lazy" : "eager"}
    decoding="async"
    class="aspect-[5/3] w-full border-b border-silk-hair object-cover"
  />
  <div class="flex grow flex-col p-6 pt-5">
    <div class="mb-4 flex items-baseline justify-between gap-4 pl-4">
      <span class="legend text-silk-faint">{refdes}</span>
      <span class:list={["legend border px-2 py-0.5", typeStyles[type]]}>{type}</span>
    </div>
    <h3 class="font-display text-2xl font-semibold tracking-wide text-silk uppercase">{title}</h3>
    <p class="legend mt-3 text-silk-dim">
      <span class="text-gold">{formatEventDate(date, endDate)}</span>
      {time && <> · {time}</>}
    </p>
    {
      (recurrence || location) && (
        <p class="legend mt-1 text-silk-faint">
          {recurrence}
          {recurrence && location && <> · </>}
          {location}
        </p>
      )
    }
    <p class="mt-4 max-w-[65ch] text-sm leading-relaxed text-silk-dim">
      {past && recap ? recap : summary}
    </p>
    <p class="legend mt-auto flex flex-wrap gap-x-6 gap-y-2 pt-6">
      {
        !past && registrationUrl && (
          <a
            href={registrationUrl}
            rel="noopener"
            class="relative z-10 text-gold underline-offset-4 hover:underline"
            aria-label={`Register for ${title}`}
          >
            Register <span aria-hidden="true">↗</span>
          </a>
        )
      }
      {
        websiteUrl && (
          <a
            href={websiteUrl}
            rel="noopener"
            class="relative z-10 text-signal-bright underline-offset-4 hover:underline"
            aria-label={`${title} website`}
          >
            Event site <span aria-hidden="true">↗</span>
          </a>
        )
      }
      <a
        href={sourceUrl}
        rel="noopener"
        class:list={[
          "underline-offset-4 hover:underline focus-visible:outline-none",
          // Stretches to cover the card. `.card-ic` is already position:relative,
          // and its ::before is the corner pin, so this uses ::after.
          "after:absolute after:inset-0 after:content-['']",
          !past && !registrationUrl && !websiteUrl ? "text-gold" : "text-silk-dim",
        ]}
        aria-label={past ? `${title} on Eagle Engage` : `Details and RSVP for ${title}`}
      >
        {past ? "On Eagle Engage" : "Details and RSVP"} <span aria-hidden="true">↗</span>
      </a>
    </p>
  </div>
</article>
