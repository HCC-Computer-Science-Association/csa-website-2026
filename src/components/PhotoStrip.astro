---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

/**
 * Drop real event photos into src/assets/photos/ and they appear here
 * automatically. Until then, the board honestly marks the footprints
 * DNP ("do not populate"), the real annotation for an intentionally
 * empty component slot.
 */
const modules = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/photos/*.{jpg,jpeg,png,webp,avif}",
  { eager: true },
);

/** Alt text by file stem. Anything unlisted falls back to a generic line. */
const alts: Record<string, string> = {
  "board-hackathon":
    "CSA officers and judges on stage at HackHCC, holding event badges",
  "coding-club":
    "Members around a conference table pointing at a screen full of hello world output",
  "coding-club-2":
    "Members talking over open laptops in the campus computer lab",
  hackHCC:
    "Hackers working at long tables in the HackHCC main hall, event branding on the screens behind them",
};

const photos = Object.entries(modules)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([path, mod]) => ({
    src: mod.default,
    stem: path.split("/").pop()!.replace(/\.[^.]+$/, ""),
  }))
  .slice(0, 4);
---

<div class="grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4">
  {
    photos.length > 0
      ? photos.map(({ src, stem }, i) => (
          <Image
            src={src}
            alt={alts[stem] ?? `CSA members at a club event, photo ${i + 1} of ${photos.length}`}
            width={480}
            class="aspect-[4/3] w-full border border-silk-hair object-cover"
          />
        ))
      : [1, 2, 3, 4].map((n) => (
          <div class="flex aspect-[4/3] flex-col items-center justify-center gap-2 border border-dashed border-silk-faint">
            <span class="legend text-silk-faint">PH{n} · DNP</span>
            <span class="legend text-silk-faint">photo pending</span>
          </div>
        ))
  }
</div>
{
  photos.length === 0 && (
    <p class="legend mt-4 text-silk-faint">
      Footprints reserved: real photos from workshops and HackHCC land here.
    </p>
  )
}
