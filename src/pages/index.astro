---
/*
  THESIS: the club as a routed circuit board, engineering documentation as
  identity; refuses the dark-SaaS hero and the neon-terminal cliché alike.
  OWN-WORLD: deep-blue soldermask ground, white silkscreen legend (B612/Saira
  Condensed), traces with 45° bends ending in vias, ENIG-gold pads for the one
  action that matters, reference designators as wayfinding.
  STORY: a freshman lands, reads a plain-English pitch printed on a beautiful
  board, sees real events and real numbers, and plugs in. Discord is the club.
  FIRST VIEWPORT: legend headline + tagline left, gold JOIN pad + outline
  SEE EVENTS beneath; right, the authored board scene where the powered trace
  pulses from U1 (the club) into J1 (join).
  FORM: Silkscreen/PCB, the user-pinned world, chosen over TTY and RFC
  renditions on the decision page.
*/
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import SectionHeader from "../components/SectionHeader.astro";
import EventCard from "../components/EventCard.astro";
import PhotoStrip from "../components/PhotoStrip.astro";
import Stats from "../components/Stats.astro";
import JoinBand from "../components/JoinBand.astro";
import BoardScene from "../components/BoardScene.astro";
import { SITE, DISCORD_URL } from "../config";
import { isUpcoming, byDateAsc, refdesCounter } from "../utils";

const events = await getCollection("events");
const upcoming = events.filter(isUpcoming).sort(byDateAsc).slice(0, 3);
const refdes = refdesCounter();
---

<Base title={`${SITE.name} · ${SITE.fullName} at ${SITE.college}`}>
  {/* U1 · hero */}
  <section class="mx-auto grid max-w-6xl items-center gap-12 px-5 pt-16 pb-20 sm:px-8 lg:grid-cols-[1.1fr_1fr] lg:pt-24 lg:pb-28">
    <div>
      <p class="legend text-silk-dim">{SITE.college} · student organization</p>
      <h1 class="mt-4 font-display text-[clamp(2.75rem,7vw,5.5rem)] leading-[0.95] font-bold tracking-wide text-silk uppercase [text-wrap:balance]">
        Computer Science Association
      </h1>
      <p class="mt-6 max-w-[52ch] text-lg text-silk-dim">
        700+ students learning, building, and shipping together: workshops,
        hackHCC, and people who have your back. Every major. Every level. Free.
      </p>
      <div class="mt-9 flex flex-wrap items-center gap-4">
        <a href={DISCORD_URL} rel="noopener" class="btn-pad">Join the Discord <span aria-hidden="true">↗</span></a>
        <a href="/events/" class="btn-silk">See events</a>
      </div>
      <p class="legend mt-10 text-silk-faint">REV A · Fall 2026 · hcc-csa.org</p>

      {/* Mobile rendition of the powered net: the current still reaches J1. */}
      <svg viewBox="0 0 340 96" fill="none" aria-hidden="true" class="mt-10 h-auto w-full max-w-[340px] sm:hidden">
        <circle cx="8" cy="16" r="4" stroke="#f2f4ff" stroke-opacity="0.5" stroke-width="1.5"></circle>
        <path d="M14 16 H150 L190 56 H278" stroke="#2001ed" stroke-opacity="0.6" stroke-width="2.5" stroke-linecap="round"></path>
        <path
          d="M14 16 H150 L190 56 H278"
          pathLength="620"
          class="trace-pulse"
          stroke="#6d7dff"
          stroke-width="2.5"
          stroke-linecap="round"></path>
        <circle cx="296" cy="56" r="16" fill="#edb100"></circle>
        <circle cx="296" cy="56" r="6" fill="#070c29"></circle>
        <text x="288" y="92" fill="#f2f4ff" fill-opacity="0.7" font-family="B612 Mono, monospace" font-size="11" letter-spacing="1">J1</text>
      </svg>
    </div>
    <div class="hidden justify-self-end sm:block">
      <BoardScene />
    </div>
  </section>

  {/* U2 · about teaser */}
  <section class="border-t border-silk-hair">
    <div class="mx-auto grid max-w-6xl gap-8 px-5 py-16 sm:px-8 lg:grid-cols-[auto_1fr_auto] lg:items-baseline lg:gap-16">
      <p class="legend text-gold">U2 · About</p>
      <p class="max-w-[65ch] text-lg leading-relaxed text-silk">
        CSA is {SITE.college}'s student-run computer science club. We teach each other: 100+
        hands-on workshops and counting, a flagship hackathon, and a community where asking a
        beginner question is the whole point, not an embarrassment.
      </p>
      <a href="/about/" class="legend text-signal-bright underline-offset-4 hover:underline">More about us →</a>
    </div>
  </section>

  {/* Y1 · upcoming events */}
  <section class="border-t border-silk-hair">
    <div class="mx-auto max-w-6xl px-5 py-20 sm:px-8 sm:py-24">
      <SectionHeader designator="Y1 · Oscillator" title="Upcoming events" />
      {
        upcoming.length > 0 ? (
          <div class="grid gap-4 sm:gap-5 [grid-template-columns:repeat(auto-fill,minmax(min(100%,290px),1fr))]">
            {upcoming.map((event) => (
              <EventCard event={event} refdes={refdes(event.data.type)} />
            ))}
          </div>
        ) : (
          <div class="border border-dashed border-silk-faint p-10">
            <p class="legend text-silk-dim">No upcoming events routed yet.</p>
            <p class="mt-2 max-w-[55ch] text-sm text-silk-dim">
              Next semester's schedule is being drawn. Announcements always land in the Discord first.
            </p>
          </div>
        )
      }
      <p class="legend mt-8">
        <a href="/events/" class="text-signal-bright underline-offset-4 hover:underline">All events →</a>
      </p>
    </div>
  </section>

  {/* PH · photo strip */}
  <section class="border-t border-silk-hair">
    <div class="mx-auto max-w-6xl px-5 py-20 sm:px-8 sm:py-24">
      <SectionHeader designator="PH · Gallery" title="In the room" />
      <PhotoStrip />
    </div>
  </section>

  {/* TP · stats */}
  <Stats />

  {/* J1 · join */}
  <JoinBand />
</Base>
