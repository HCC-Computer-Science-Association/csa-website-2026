---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import SectionHeader from "../components/SectionHeader.astro";
import { SITE, DISCORD_URL } from "../config";

/**
 * Each officer is an IC on the board; their profile links are the connector
 * pins printed along its bottom edge, same grammar as the footer's J3 block.
 */
const officers = (await getCollection("team"))
  .sort((a, b) => a.data.order - b.data.order)
  .map(({ data }) => ({
    ...data,
    links: [
      data.linkedin ? { label: "LinkedIn", href: data.linkedin } : null,
      data.github ? { label: "GitHub", href: data.github } : null,
    ].filter((link) => link !== null),
  }));
---

<Base
  title={`Team · ${SITE.name} at ${SITE.college}`}
  description="The student officers who run Computer Science Association at Houston City College."
>
  <div class="mx-auto max-w-6xl px-5 pt-16 pb-24 sm:px-8">
    <SectionHeader as="h1" designator="J2 · Pin header" title="The officers" />
    <p class="-mt-4 mb-14 max-w-[65ch] text-silk-dim">
      Students, all of us, keeping the club running: planning workshops,
      organizing HackHCC, and answering your questions.
    </p>

    <div class="grid gap-4 sm:gap-5 [grid-template-columns:repeat(auto-fill,minmax(min(100%,240px),1fr))]">
      {
        officers.map((officer, i) => (
          <article class="card-ic flex flex-col">
            <div class="grow p-6">
              {officer.photo ? (
                <Image
                  src={officer.photo}
                  alt={`Portrait of ${officer.name}`}
                  width={480}
                  class="mb-5 aspect-square w-full border border-silk-hair object-cover"
                />
              ) : (
                <div class="mb-5 flex aspect-square w-full flex-col items-center justify-center gap-2 border border-dashed border-silk-faint">
                  <span class="legend text-silk-faint">DNP</span>
                  <span class="legend text-silk-faint">headshot pending</span>
                </div>
              )}
              <p class="legend text-silk-faint">PIN {i + 1}</p>
              <h2 class="mt-1 font-display text-xl font-semibold tracking-wide text-silk uppercase">{officer.name}</h2>
              <p class="legend mt-1 text-gold">{officer.role}</p>
            </div>
            {officer.links.length > 0 && (
              <ul class="border-t border-silk-hair">
                {officer.links.map(({ label, href }) => (
                  <li class="border-t border-silk-hair first:border-t-0">
                    <a
                      href={href}
                      rel="noopener"
                      aria-label={`${officer.name} on ${label}`}
                      class="legend group/pin flex items-center gap-3 px-6 py-3.5 text-silk-dim transition-colors hover:bg-pour hover:text-silk"
                    >
                      <span class="via shrink-0 transition-colors group-hover/pin:border-silk" />
                      {label}
                      <span aria-hidden="true" class="ml-auto">↗</span>
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </article>
        ))
      }
    </div>

    <p class="mt-14 max-w-[60ch] text-sm text-silk-dim">
      Want a seat here someday? Officers come from the community.
      <a href={DISCORD_URL} rel="noopener" class="text-signal-bright underline underline-offset-4">Join the Discord</a>, show up, and get involved.
    </p>
  </div>
</Base>
